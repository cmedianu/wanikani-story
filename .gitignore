# Credentials — never commit
.token
token
*.token

# Local planning docs (contain learner-specific details). May be a symlink
# into a private repo — no trailing slash, or the pattern would match only
# a real directory, not the link.
specs

# Local config and learner data live in ~/.config/wanikani-story/ by default,
# but guard against accidental in-repo copies too
config.json
data/
cache/
inventory.json
series/

# Python
__pycache__/
*.pyc

# OS noise
.DS_Store
